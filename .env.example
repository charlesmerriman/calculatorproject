# Copy to .env and fill in. .env is gitignored; this file documents the shape.

# --- Core --------------------------------------------------------------------
DEBUG=True
# Required in production. Locally it falls back to an insecure default.
DJANGO_SECRET_KEY=
# Comma-separated. Defaults to localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=
# PostgreSQL connection string. Falls back to db.sqlite3 when unset.
DATABASE_URL=

# --- Frontend origin ---------------------------------------------------------
# The backend derives OAUTH_REDIRECT_URI as "<FRONTEND_URL>/auth/callback".
# That value must match what is registered in the provider consoles EXACTLY,
# including scheme and the absence of a trailing slash.
FRONTEND_URL=http://localhost:5173

# Extra redirect URIs /auth/<provider>/start will accept when the SPA asks for
# one by name, on top of the derived OAUTH_REDIRECT_URI above. Comma-separated.
#
# Leave this BLANK locally: FRONTEND_URL is already localhost, so the derived
# URI covers you. It exists for DEPLOYED apps, where setting
#   http://localhost:5173/auth/callback
# lets `npm run dev:live` complete a real sign-in against that deployment
# instead of bouncing the developer to the deployed site.
#
# Setting this on a public deployment is a deliberate decision: it permits that
# app to hand authorization codes to a loopback address. Entries must be
# byte-exact and registered in the provider console. Unlisted values are
# refused, which is what stops this being an open redirector.
OAUTH_EXTRA_REDIRECT_URIS=

# Comma-separated origins allowed to call the API cross-origin.
CORS_ORIGIN_WHITELIST=http://localhost:5173

# --- Social sign-in ----------------------------------------------------------
# Google:  console.cloud.google.com -> APIs & Services -> Credentials
#          -> OAuth 2.0 Client ID (Web application)
# Discord: discord.com/developers/applications -> your app -> OAuth2
#
# Register BOTH redirect URIs in each console:
#   http://localhost:5173/auth/callback
#   https://<your-production-host>/auth/callback
# (Google permits plain http only for localhost.)
#
# Scopes are set in code to the narrowest each provider allows — "openid" for
# Google and "identify" for Discord — so no email address is ever sent to us.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# --- DigitalOcean Spaces (media storage) -------------------------------------
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=
DO_SPACES_BUCKET_NAME=
DO_SPACES_ENDPOINT_URL=
DO_SPACES_CDN_DOMAIN=
